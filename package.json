{
  "name": "replycraft",
  "version": "1.0.0",
  "description": "Lightweight Express.js toolkit for standardized API responses, centralized error handling, pagination, and request tracking.",
  "main": "./src/index.cjs",
  "module": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./src/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/cjs.test.cjs tests/esm.test.mjs tests/unit.test.js tests/integration.test.js tests/example.test.js",
    "example": "node examples/express-server.js"
  },
  "keywords": [
    "express",
    "response",
    "error-handling",
    "pagination",
    "request-id",
    "api",
    "middleware",
    "standardized-responses",
    "async-handler",
    "rest-api"
  ],
  "author": "ReplyCraft Contributors",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "express": "^4.21.2",
    "supertest": "^7.0.0"
  }
}
